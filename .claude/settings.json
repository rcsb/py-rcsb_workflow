{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git push -u origin *)"
    ],
    "deny": [
      "Bash(git push *master*)",
      "Bash(git push *HEAD*)",
      "Bash(git push)",
      "Bash(git push origin)",
      "Bash(git push -u origin)",
      "Bash(git push *--all*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--force*)",
      "Bash(git push -f *)",
      "Bash(git push * -f *)",
      "Bash(git push * -f)",
      "Bash(git push * +*)",
      "Bash(git push *--no-verify*)",
      "Bash(git -C * push *)",
      "Bash(git -c * push *)",
      "Bash(gh)",
      "Bash(gh *)"
    ]
  }
}
